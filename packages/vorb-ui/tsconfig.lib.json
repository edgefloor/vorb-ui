{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "node_modules/.cache/vorb-ui-lib.tsbuildinfo"
  },
  "include": [
    "src/index.ts",
    "src/adapters/**/*.ts",
    "src/components/ui/voice-orb/**/*.ts",
    "src/components/ui/voice-orb/**/*.tsx"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
