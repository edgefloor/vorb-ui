{
  "name": "vorb-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run build:package && bun run build:web",
    "build:package": "bun run --cwd packages/vorb-ui build",
    "build:web": "bun run --cwd apps/web build",
    "typecheck": "bun run --cwd packages/vorb-ui typecheck && bun run --cwd apps/web typecheck",
    "test": "bun run --cwd packages/vorb-ui test",
    "typecheck:package": "bun run --cwd packages/vorb-ui typecheck:package",
    "test:package": "bun run --cwd packages/vorb-ui test:package",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "test:e2e": "bun run typecheck:e2e && playwright test",
    "test:e2e:built": "bun run build:package && bun run test:e2e",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run typecheck:package && bun run test:package && bun run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.54.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "vorb-ui": "workspace:*",
    "prettier": "^3.6.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
